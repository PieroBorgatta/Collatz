CollatzShadowing.PrefixOptimality.prefixMaximum_exact (v Q H M K : ℕ) (hQ : 0 < Q) (hHM : H ≤ M) (hMK : M ≤ K) :
  (∀ (x : ℕ),
      0 < x →
        x ≡ Q [MOD 2 ^ M] →
          CollatzShadowing.PrefixOptimality.defect v H K x ≤
            CollatzShadowing.PrefixOptimality.prefixMaximum v Q H M K) ∧
    ∃ x,
      0 < x ∧
        x ≡ Q [MOD 2 ^ M] ∧
          CollatzShadowing.PrefixOptimality.defect v H K x = CollatzShadowing.PrefixOptimality.prefixMaximum v Q H M K
CollatzShadowing.PrefixOptimality.certificate_iff_zeros (v Q H M K : ℕ) (g : ℤ) (hQ : 0 < Q) (hHM : H ≤ M)
  (hMK : M ≤ K) :
  (∀ (x : ℕ), 0 < x → x ≡ Q [MOD 2 ^ M] → CollatzShadowing.PrefixOptimality.defect v H K x ≤ g) ↔
    ↑K - 2 * ↑(CollatzShadowing.PrefixOptimality.J Q H) - g ≤ ↑(CollatzShadowing.PrefixOptimality.observedZeros v Q M)
